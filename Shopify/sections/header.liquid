<aside class="announcement-bar">
  <div class="announcement-bar__text">
    {{ section.settings.announcement_text | default: 'COMPLIMENTARY DOMESTIC SHIPPING OVER ₹999 • ARCHITECTURAL CASUALS' }}
  </div>
</aside>

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__brand">
      <a href="/" class="site-header__logo">
        <span class="site-header__logo-text">URBAN THREADS</span>
      </a>
    </div>

    <nav class="site-header__nav">
      <ul class="site-header__nav-list">
        <li><a href="/collections/men">Men</a></li>
        <li><a href="/collections/women">Women</a></li>
        <li><a href="/collections/all" class="is-active">Essentials</a></li>
        <li><a href="/pages/about-us">About</a></li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="site-header__search-box">
        <span class="site-header__search-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <input type="text" class="site-header__search-input" placeholder="Search essentials...">
      </div>

      <a href="/pages/wishlist" class="header-icon-link" aria-label="Saved Items">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span class="header-icon-badge">2</span>
      </a>

      <a href="/cart" class="header-icon-link" aria-label="Cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="header-icon-badge header-icon-badge--cart">{{ cart.item_count | default: 0 }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announcement_text", "label": "Announcement Text", "default": "COMPLIMENTARY DOMESTIC SHIPPING OVER ₹999 • ARCHITECTURAL CASUALS" }
  ]
}
{% endschema %}
