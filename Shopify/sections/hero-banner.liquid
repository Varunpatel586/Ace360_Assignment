<section class="hero-banner">
  <div class="container hero-banner__inner">
    <!-- Left Hero Column -->
    <div class="hero-banner__content">
      <div class="hero-promo-badge">
        <span class="hero-promo-badge__dot"></span>
        <span class="hero-promo-badge__text">SPRING / SUMMER 2024 DROP</span>
      </div>

      <h1 class="hero-banner__title">
        <span>{{ section.settings.heading | default: 'EFFORTLESS' }}</span>
        <span>{{ section.settings.subheading | default: 'EVERYDAY STYLE.' }}</span>
      </h1>

      <p class="hero-banner__description">
        {{ section.settings.description | default: 'Premium casuals engineered for daily wear and relaxed comfort. Thoughtful cuts, tailored in breathable 100% Indian cotton.' }}
      </p>

      <div class="hero-banner__actions">
        <a href="{{ section.settings.primary_btn_url | default: '/collections/men' }}" class="btn-hero-primary">
          {{ section.settings.primary_btn_text | default: 'SHOP MEN' }}
        </a>
        <a href="{{ section.settings.secondary_btn_url | default: '/collections/women' }}" class="btn-hero-secondary">
          {{ section.settings.secondary_btn_text | default: 'SHOP WOMEN' }}
        </a>
      </div>

      <!-- Micro Specs Stats integrated per Figma layout -->
      <div class="hero-micro-specs">
        <div class="micro-spec-col">
          <span class="micro-spec-col__value">240 GSM</span>
          <span class="micro-spec-col__label">Heavy Cotton</span>
        </div>
        <div class="micro-spec-col">
          <span class="micro-spec-col__value">Pre-Shrunk</span>
          <span class="micro-spec-col__label">Zero Sagging</span>
        </div>
        <div class="micro-spec-col">
          <span class="micro-spec-col__value">₹999+</span>
          <span class="micro-spec-col__label">Free Delivery</span>
        </div>
      </div>
    </div>

    <!-- Right Hero Column: Editorial Imagery Duo -->
    <div class="hero-banner__imagery">
      <div class="hero-img-card">
        <div class="hero-img-card__visual">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#A0A09E" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        </div>
        <span class="hero-img-card__tag">MEN'S DROP</span>
      </div>

      <div class="hero-img-card hero-img-card--offset">
        <div class="hero-img-card__visual">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#A0A09E" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        </div>
        <span class="hero-img-card__tag">WOMEN'S CASUAL</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "EFFORTLESS" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "EVERYDAY STYLE." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Premium casuals engineered for daily wear and relaxed comfort. Thoughtful cuts, tailored in breathable 100% Indian cotton." },
    { "type": "text", "id": "primary_btn_text", "label": "Primary Button Text", "default": "SHOP MEN" },
    { "type": "url", "id": "primary_btn_url", "label": "Primary Button URL" },
    { "type": "text", "id": "secondary_btn_text", "label": "Secondary Button Text", "default": "SHOP WOMEN" },
    { "type": "url", "id": "secondary_btn_url", "label": "Secondary Button URL" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
