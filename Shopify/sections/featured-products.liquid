<section class="featured-products">
  <div class="container">
    <div class="section-head-row">
      <div class="section-head-row__left">
        <span class="section-eyebrow">CATALOG DIRECTORY</span>
        <h2 class="section-main-heading">{{ section.settings.heading | default: 'FEATURED ESSENTIALS' }}</h2>
      </div>
      <div class="filter-chips-row">
        <button class="filter-chip filter-chip--active">ALL (6)</button>
        <button class="filter-chip filter-chip--inactive">MEN</button>
        <button class="filter-chip filter-chip--inactive">WOMEN</button>
      </div>
    </div>

    <!-- Product Grid: 6 Items from Figma Catalog -->
    <div class="catalog-products-grid">
      <!-- Product 1: Men's Classic Cotton T-Shirt -->
      <article class="figma-product-card">
        <div class="figma-product-card__visual">
          <span class="figma-product-card__badge figma-product-card__badge--bestseller">BEST SELLER</span>
          <button class="figma-product-card__wishlist" aria-label="Add to Wishlist">
            <svg width="15" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </button>
          <div class="figma-product-card__placeholder">Product Visual</div>
        </div>
        <div class="figma-product-card__info">
          <div class="figma-product-card__meta-row">
            <span class="figma-product-card__category">Men's Casual</span>
            <span class="figma-product-card__sku">SKU: MTS001</span>
          </div>
          <h3 class="figma-product-card__title">Men's Classic Cotton T-Shirt</h3>
          <div class="figma-product-card__bottom-row">
            <span class="figma-product-card__price">₹699</span>
            <div class="figma-product-card__swatches">
              <span class="swatch-circle" style="background:#000000;" title="Black"></span>
              <span class="swatch-circle" style="background:#FFFFFF;" title="White"></span>
              <span class="swatch-circle" style="background:#18233C;" title="Navy Blue"></span>
            </div>
          </div>
        </div>
      </article>

      <!-- Product 2: Women's Essential T-Shirt -->
