{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FEATURED ESSENTIALS" }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
