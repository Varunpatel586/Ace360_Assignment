<section class="brand-perks-section">
  <div class="container">
    <div class="brand-perks-grid">
      <!-- Perk 1 -->
      <div class="perk-card">
        <div class="perk-card__icon-wrap">
          <svg width="20" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <h4 class="perk-card__title">Express Shipping</h4>
        <p class="perk-card__desc">Dispatched within 24 hours. Free delivery on domestic orders ₹999+.</p>
      </div>

      <!-- Perk 2 -->
      <div class="perk-card">
        <div class="perk-card__icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        </div>
        <h4 class="perk-card__title">Easy 7-Day Returns</h4>
        <p class="perk-card__desc">Hassle-free doorstep exchange and return pickup across 18,000+ pin codes.</p>
      </div>

      <!-- Perk 3 -->
      <div class="perk-card">
        <div class="perk-card__icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h4 class="perk-card__title">100% Indian Cotton</h4>
        <p class="perk-card__desc">Sustainably sourced premium combed cotton. Pre-shrunk with zero sagging.</p>
      </div>

      <!-- Perk 4 -->
      <div class="perk-card">
        <div class="perk-card__icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h4 class="perk-card__title">Secure Checkout</h4>
        <p class="perk-card__desc">256-bit SSL encrypted transactions. All UPI, cards, and net banking accepted.</p>
      </div>
    </div>
  </div>
</section>

