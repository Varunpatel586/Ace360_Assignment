<!-- Micro Specs standalone section (optional or kept for modular OS 2.0 theme builder) -->
<section class="micro-specs" style="background:#F4F3F0; border-bottom:1px solid #E3E2DF; padding:24px 0;">
  <div class="container" style="display:flex; justify-content:center; gap:64px;">
    <div style="display:flex; flex-direction:column; align-items:center;">
      <span style="font-family:var(--font-mono); font-weight:600; font-size:18px; color:#000;">240 GSM</span>
      <span style="font-family:var(--font-body); font-size:14px; color:#444748;">Heavy Cotton</span>
    </div>
    <div style="display:flex; flex-direction:column; align-items:center;">
      <span style="font-family:var(--font-mono); font-weight:600; font-size:18px; color:#000;">Pre-Shrunk</span>
      <span style="font-family:var(--font-body); font-size:14px; color:#444748;">Zero Sagging</span>
    </div>
    <div style="display:flex; flex-direction:column; align-items:center;">
      <span style="font-family:var(--font-mono); font-weight:600; font-size:18px; color:#000;">₹999+</span>
      <span style="font-family:var(--font-body); font-size:14px; color:#444748;">Free Delivery</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Micro Specs",
  "settings": [],
  "presets": [{ "name": "Micro Specs" }]
}
{% endschema %}
